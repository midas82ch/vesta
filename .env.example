POSTGRES_DB=vesta
POSTGRES_USER=vesta
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql://vesta:change-me-for-non-local-use@db:5432/vesta
ADMIN_DATABASE_URL=
OFFER_DATA_PATH=/app/data/seed/offers.example.json
OFFER_SOURCE_CATALOG_PATH=/app/data/sources/bern_offers.json
VESTA_API_URL=http://localhost:8000
VESTA_ENV=development
VESTA_SITE_ADDRESS=http://localhost

# AI-Gateway (siehe docs/adr/0004-*.md): bleibt standardmaessig deaktiviert,
# solange Datenuebertragung/Vertrag nicht freigegeben sind (docs/hosting.md).
# Nur fuer den lokalen Prototyp-Vergleich bewusst aktivieren.
VESTA_AI_ENABLED=false
VESTA_AI_PROVIDER=openai
VESTA_AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
VESTA_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=./secrets/openai-api-key

# Adminbereich: echte Admin-Zugaenge werden ausschliesslich per
# `python -m vesta_api.cli.create_admin_user` gegen die Datenbank angelegt.
# Die folgenden zwei Variablen sind NUR eine lokale Entwicklungs-Abkuerzung
# (seedet einen In-Memory-Admin, wenn keine DATABASE_URL gesetzt ist) und
# duerfen in Produktion nie gesetzt werden.
VESTA_DEV_ADMIN_USERNAME=
VESTA_DEV_ADMIN_PASSWORD=

# Produktion: durch provision_database_roles.py erzeugter, eingeschränkter
# Schreibzugang für authentifizierte Angebots- und Kategorienverwaltung.
DATABASE_ADMIN_WRITE_URL_FILE=./secrets/database-admin-write-url
DATABASE_WORKER_URL_FILE=./secrets/database-worker-url
VESTA_OFFER_URL_IMPORT_ENABLED=false
